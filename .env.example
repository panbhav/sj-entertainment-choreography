# Set the public domain before publishing; leave empty for an unindexed preview.
NEXT_PUBLIC_SITE_URL=
# Default: the Contact form posts to FormSubmit (works on static GitHub Pages).
# Confirm the one-time activation email sent to sjentertainmentch@gmail.com after
# the first submission. Keep CAPTCHA enabled. No provider API key is required.
# Optional override for server hosting only: enable a tested HTTPS JSON webhook.
ENQUIRY_DELIVERY_ENABLED=false
ENQUIRY_WEBHOOK_URL=
# Optional bearer authentication for that endpoint. Never expose this with NEXT_PUBLIC_.
ENQUIRY_DELIVERY_KEY=
