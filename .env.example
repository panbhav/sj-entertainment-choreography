# Requires server-capable Next.js hosting. GitHub Pages cannot run the APIs.
NEXT_PUBLIC_SITE_URL=
# Keep false until both providers are configured, tested and ingress abuse limits are enabled.
NOTIFICATIONS_ENABLED=false
# Server secrets only. Never use NEXT_PUBLIC_ for these values.
RESEND_API_KEY=
# A sender on your Resend-verified domain, not the recipient Gmail address.
NOTIFICATIONS_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Messaging service containing an approved WhatsApp Business sender.
TWILIO_MESSAGING_SERVICE_SID=
# Approved template with five variables: kind, name, phone, city, short details.
TWILIO_CONTENT_SID=
# Recipients are fixed server-side: sjentertainmentch@gmail.com / +918233277258.
